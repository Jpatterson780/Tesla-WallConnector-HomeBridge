{
  "pluginAlias": "TeslaWallConnectorLocal",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Monitors one or more Tesla Wall Connectors (Gen 3) over your local network using the charger's `/api/1/vitals` endpoint. Give each charger a static IP / DHCP reservation.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "Tesla Wall Connector",
        "required": true
      },
      "chargers": {
        "title": "Wall Connectors",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "default": "Wall Connector",
              "required": true
            },
            "host": {
              "title": "IP Address / Hostname",
              "type": "string",
              "placeholder": "192.168.1.50",
              "description": "Required. A charger entry without an IP address is ignored, along with all of its settings.",
              "required": true
            },
            "showChargingSensor": {
              "title": "Charging (occupancy sensor: occupied while charging)",
              "type": "boolean",
              "default": true
            },
            "showVehicleConnectedSensor": {
              "title": "Vehicle Connected (contact sensor: closed while plugged in)",
              "type": "boolean",
              "default": true
            },
            "showOutlet": {
              "title": "Outlet (adds power and energy readings in the Eve app)",
              "description": "On/Off shows whether it's charging, but it can't be switched: the charger's local API is read-only.",
              "type": "boolean",
              "default": false
            },
            "showHandleTemperature": {
              "title": "Handle Temperature",
              "description": "Temperature sensors are included in the Home app's climate summary for the room.",
              "type": "boolean",
              "default": false
            },
            "showPcbaTemperature": {
              "title": "PCBA (internal board) Temperature",
              "type": "boolean",
              "default": false
            },
            "showMcuTemperature": {
              "title": "MCU Temperature",
              "type": "boolean",
              "default": false
            },
            "pollInterval": {
              "title": "Poll Interval (seconds)",
              "type": "integer",
              "default": 15,
              "minimum": 5,
              "maximum": 3600
            },
            "timeout": {
              "title": "Request Timeout (seconds)",
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 60
            }
          }
        }
      }
    }
  },
  "layout": [
    "name",
    {
      "key": "chargers",
      "type": "array",
      "orderable": false,
      "buttonText": "Add Wall Connector",
      "items": [
        "chargers[].name",
        "chargers[].host",
        {
          "type": "fieldset",
          "title": "HomeKit tiles",
          "description": "Choose what this charger shows in HomeKit. Restart Homebridge after changing these.",
          "items": [
            "chargers[].showChargingSensor",
            "chargers[].showVehicleConnectedSensor",
            "chargers[].showOutlet",
            "chargers[].showHandleTemperature",
            "chargers[].showPcbaTemperature",
            "chargers[].showMcuTemperature"
          ]
        },
        {
          "type": "fieldset",
          "title": "Advanced",
          "expandable": true,
          "items": [
            "chargers[].pollInterval",
            "chargers[].timeout"
          ]
        }
      ]
    }
  ]
}
